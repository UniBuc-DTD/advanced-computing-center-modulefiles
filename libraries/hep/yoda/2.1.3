#%Module1.0
##
## YODA 2.1.3 Modulefile
##

proc ModulesHelp { } {
    puts stderr "\tSets up YODA 2.1.3"
}

module-whatis "Sets up YODA 2.1.3"

set version 2.1.3
set prefix "/mnt/modules/software/libraries/hep/yoda/$version"

conflict libraries/hep/yoda

# Add tool binaries to path
prepend-path PATH $prefix/bin

# Update include path
prepend-path CPLUS_INCLUDE_PATH $prefix/include

# Update library path
prepend-path LIBRARY_PATH $prefix/lib
prepend-path LD_LIBRARY_PATH $prefix/lib

# Update PkgConfig (for build systems like CMake/Meson)
prepend-path PKG_CONFIG_PATH $prefix/lib/pkgconfig

# Update Python path
prepend-path PYTHONPATH $prefix/lib/python3.14/site-packages
