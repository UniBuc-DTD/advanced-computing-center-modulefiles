#%Module1.0
##
## FastJet-Contrib 1.102 Modulefile
##

proc ModulesHelp { } {
    puts stderr "\tSets up FastJet Contrib 1.102"
}

module-whatis "Sets up FastJet Contrib 1.102"

set version 1.102
set prefix "/mnt/modules/software/libraries/hep/fastjet-contrib/$version"

prereq libraries/hep/fastjet/3.5.1
conflict libraries/hep/fastjet-contrib

# Update include path (for compiling)
prepend-path CPLUS_INCLUDE_PATH $prefix/include

# Update library path (for linking)
prepend-path LIBRARY_PATH $prefix/lib
prepend-path LD_LIBRARY_PATH $prefix/lib
