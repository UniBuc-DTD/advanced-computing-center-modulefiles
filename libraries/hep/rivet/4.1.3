#%Module1.0
##
## Rivet 4.1.3 Modulefile
##

proc ModulesHelp { } {
    puts stderr "\tSets up Rivet analysis toolkit version 4.1.3"
}

module-whatis "Sets up Rivet 4.1.3"

set appname rivet
set version 4.1.3
set prefix "/mnt/modules/software/libraries/hep/$appname/$version"

conflict libraries/hep/$appname

prepend-path PATH $prefix/bin

# Update include path
prepend-path CPATH $prefix/include
prepend-path CPLUS_INCLUDE_PATH $prefix/include

# Update library paths
prepend-path LIBRARY_PATH $prefix/lib
prepend-path LD_LIBRARY_PATH $prefix/lib

# Update pkg-config path (for build systems like CMake/Meson)
prepend-path PKG_CONFIG_PATH $prefix/lib/pkgconfig

# Update Python path
prepend-path PYTHONPATH $prefix/lib/python3.14/site-packages

# Convenience variables
setenv RIVET_ROOT $prefix
setenv RIVET_INC $prefix/include
setenv RIVET_LIB $prefix/lib
