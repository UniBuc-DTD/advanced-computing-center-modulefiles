#%Module1.0
##
## FreeType 2.14.3 Modulefile
##

proc ModulesHelp { } {
    puts stderr "\tSets up FreeType 2.14.3"
}

module-whatis "Sets up FreeType 2.14.3"

set libname freetype
set version 2.14.3
set prefix "/mnt/modules/software/libraries/$libname/$version"

# Prevent loading multiple versions of FreeType at the same time
conflict libraries/$libname

# Update include paths
prepend-path CPATH $prefix/include
prepend-path C_INCLUDE_PATH $prefix/include

# Update library paths
prepend-path LIBRARY_PATH $prefix/lib
prepend-path LD_LIBRARY_PATH $prefix/lib

# Update CMake path
prepend-path CMAKE_PREFIX_PATH $prefix

# Update pkg-config path
prepend-path PKG_CONFIG_PATH $prefix/lib/pkgconfig
