#%Module1.0
##
## TeX Live 2026 Modulefile
##

proc ModulesHelp { } {
    puts stderr "Sets up environment for TeX Live 2026 (scheme-full, shared install)"
    puts stderr "NOTE: shared read-only install - do not try to run 'tlmgr update' or 'tlmgr install'."
}

module-whatis "Sets up TeX Live 2026 (scheme-full, shared install)"
module-whatis "Do not try to run `tlmgr update/install`; request missing packages from the ACC system administrators."

set appname texlive
set version 2026
set prefix "/mnt/modules/software/tools/$appname/$version"

conflict tools/$appname

# Binaries
prepend-path PATH $prefix/bin/x86_64-linux

# Per-user writable state (formats, font caches, config) lives in each user's home
setenv TEXMFHOME $env(HOME)/texmf
setenv TEXMFVAR $env(HOME)/.texlive2026/texmf-var
setenv TEXMFCONFIG $env(HOME)/.texlive2026/texmf-config

# Man pages
prepend-path MANPATH $prefix/texmf-dist/doc/man
