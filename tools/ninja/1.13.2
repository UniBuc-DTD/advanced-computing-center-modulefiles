#%Module1.0
##
## Ninja 1.13.2 Modulefile
##

proc ModulesHelp { } {
    puts stderr "\tSets up Ninja build tool version $version"
}

module-whatis "Sets up Ninja 1.13.2"

set appname ninja
set version 1.13.2
set prefix "/mnt/modules/software/tools/$appname/$version"

conflict tools/$appname

# Binary
prepend-path PATH $prefix/bin
